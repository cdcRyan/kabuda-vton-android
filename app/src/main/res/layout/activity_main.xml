<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/kb_bg">

    <!-- ───────── Video layers ───────── -->

    <FrameLayout
        android:id="@+id/remoteRenderer"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <FrameLayout
        android:id="@+id/localRenderer"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@color/kb_bg"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- ───────── Empty state (camera off) ───────── -->

    <LinearLayout
        android:id="@+id/emptyState"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="28dp"
        android:paddingEnd="28dp"
        app:layout_constraintBottom_toTopOf="@id/dock"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.62">

        <TextView
            style="@style/Kabuda.Text.Overline"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/empty_overline" />

        <TextView
            style="@style/Kabuda.Text.Display"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:lineSpacingMultiplier="1.15"
            android:text="@string/empty_title" />

        <TextView
            style="@style/Kabuda.Text.Body"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/empty_body" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="28dp"
            android:background="@color/kb_line" />

        <include
            android:id="@+id/stepKey"
            layout="@layout/item_step" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/kb_line" />

        <include
            android:id="@+id/stepGarment"
            layout="@layout/item_step" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/kb_line" />

        <include
            android:id="@+id/stepCamera"
            layout="@layout/item_step" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/kb_line" />
    </LinearLayout>

    <!-- ───────── Scrims (only over live video) ───────── -->

    <View
        android:id="@+id/scrimTop"
        android:layout_width="0dp"
        android:layout_height="180dp"
        android:background="@drawable/bg_scrim_top"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <View
        android:id="@+id/scrimBottom"
        android:layout_width="0dp"
        android:layout_height="260dp"
        android:background="@drawable/bg_scrim_bottom"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <!-- ───────── Top bar ───────── -->

    <LinearLayout
        android:id="@+id/topBar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="12dp"
        android:paddingEnd="16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/brand"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="serif"
                android:shadowColor="#80000000"
                android:shadowRadius="8"
                android:text="@string/app_name"
                android:textColor="@color/kb_ink"
                android:textSize="22sp"
                android:textStyle="bold" />

            <ImageButton
                android:id="@+id/moreButton"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@drawable/bg_glass_circle"
                android:contentDescription="@string/session_sheet_title"
                android:foreground="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_more"
                app:tint="@color/kb_ink" />

            <ImageButton
                android:id="@+id/settingsButton"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_marginStart="10dp"
                android:background="@drawable/bg_glass_circle"
                android:contentDescription="@string/settings"
                android:foreground="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_tune"
                app:tint="@color/kb_ink" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/statusPill"
            android:layout_width="wrap_content"
            android:layout_height="34dp"
            android:layout_marginTop="10dp"
            android:animateLayoutChanges="true"
            android:background="@drawable/bg_glass_pill"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="12dp"
            android:paddingEnd="14dp">

            <View
                android:id="@+id/statusDot"
                android:layout_width="7dp"
                android:layout_height="7dp"
                android:background="@drawable/bg_dot"
                android:backgroundTint="@color/kb_ink_faint" />

            <TextView
                android:id="@+id/liveBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:fontFamily="sans-serif-medium"
                android:letterSpacing="0.14"
                android:text="@string/live_badge"
                android:textColor="@color/kb_live"
                android:textSize="11sp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/statusText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:ellipsize="end"
                android:maxWidth="260dp"
                android:maxLines="1"
                android:text="@string/status_idle"
                android:textColor="@color/kb_ink"
                android:textSize="13sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- ───────── Dock ───────── -->

    <LinearLayout
        android:id="@+id/dock"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:baselineAligned="false"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="24dp"
        android:paddingTop="12dp"
        android:paddingEnd="24dp"
        android:paddingBottom="20dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <!-- Garment -->
        <LinearLayout
            android:id="@+id/selectButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/select_garment"
            android:gravity="center"
            android:orientation="vertical">

            <FrameLayout
                android:layout_width="60dp"
                android:layout_height="60dp">

                <com.google.android.material.imageview.ShapeableImageView
                    android:id="@+id/garmentPreview"
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:layout_gravity="center"
                    android:background="@color/kb_surface_highest"
                    android:padding="14dp"
                    android:scaleType="centerInside"
                    android:src="@drawable/ic_hanger"
                    app:shapeAppearance="@style/ShapeAppearance.Kabuda.Thumb"
                    app:strokeColor="@color/kb_glass_stroke"
                    app:strokeWidth="1dp"
                    app:tint="@color/kb_ink" />

                <ImageView
                    android:id="@+id/garmentBadge"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_gravity="top|end"
                    android:background="@drawable/bg_dot"
                    android:backgroundTint="@color/kb_ink"
                    android:importantForAccessibility="no"
                    android:padding="3dp"
                    android:src="@drawable/ic_plus"
                    app:tint="@color/kb_bg" />
            </FrameLayout>

            <TextView
                android:id="@+id/garmentName"
                style="@style/Kabuda.Text.DockLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:ellipsize="middle"
                android:maxWidth="96dp"
                android:maxLines="1"
                android:text="@string/dock_garment" />
        </LinearLayout>

        <!-- Shutter -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="vertical">

            <FrameLayout
                android:id="@+id/tryonButton"
                android:layout_width="84dp"
                android:layout_height="84dp"
                android:background="@drawable/bg_shutter_ring"
                android:clickable="true"
                android:contentDescription="@string/start_tryon"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackgroundBorderless">

                <View
                    android:id="@+id/tryonCore"
                    android:layout_width="64dp"
                    android:layout_height="64dp"
                    android:layout_gravity="center" />

                <ImageView
                    android:id="@+id/tryonIcon"
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:layout_gravity="center"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_sparkle"
                    app:tint="@color/kb_bg" />

                <com.google.android.material.progressindicator.CircularProgressIndicator
                    android:id="@+id/tryonProgress"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:indeterminate="true"
                    android:visibility="gone"
                    app:indicatorColor="@color/kb_amber"
                    app:indicatorSize="84dp"
                    app:trackThickness="3dp" />
            </FrameLayout>

            <TextView
                android:id="@+id/tryonLabel"
                style="@style/Kabuda.Text.DockLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/start_tryon" />
        </LinearLayout>

        <!-- Camera -->
        <LinearLayout
            android:id="@+id/cameraButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/start_camera"
            android:gravity="center"
            android:orientation="vertical">

            <FrameLayout
                android:layout_width="60dp"
                android:layout_height="60dp">

                <ImageView
                    android:id="@+id/cameraIcon"
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:layout_gravity="center"
                    android:background="@drawable/bg_glass_circle"
                    android:importantForAccessibility="no"
                    android:padding="15dp"
                    android:src="@drawable/ic_camera"
                    app:tint="@color/kb_ink" />
            </FrameLayout>

            <TextView
                android:id="@+id/cameraLabel"
                style="@style/Kabuda.Text.DockLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/dock_camera_on" />
        </LinearLayout>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
